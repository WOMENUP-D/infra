# TLS is terminated by the existing public Caddy (see ingress.caddy).
http://:8080 {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000"
        -Server
    }
    @backend path /api/* /health /health/ready
    handle @backend {
        reverse_proxy womanup-api:8000
    }
    handle {
        reverse_proxy womanup-web:3000
    }
}
